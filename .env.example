# Copy this file to .env and fill in real values. .env is gitignored.

# OpenRouter API Key for the AI document-drafting assistant.
# Free tier: openai/gpt-oss-120b:free (20 req/min, 200 req/day).
OPENROUTER_API_KEY=

# Secret used to sign backend auth JWTs. Generate a real one for anything
# beyond local development, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
